<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.madassignment1">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MADAssignment1">
        <activity
            android:name=".mainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MADAssignment1.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".studentPage"
            android:theme="@style/Theme.MADAssignment1.NoActionBar"></activity>
        <activity android:name=".studentEditView"
            android:theme="@style/Theme.MADAssignment1.NoActionBar"></activity>
       <activity android:name=".taskEditView"
            android:theme="@style/Theme.MADAssignment1.NoActionBar"></activity>
        <activity android:name=".taskPage"
            android:theme="@style/Theme.MADAssignment1.NoActionBar"></activity>

    </application>

</manifest>